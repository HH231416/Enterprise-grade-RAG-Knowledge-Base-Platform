# Copy to deployment secret storage or a protected .env.production file.
# Do not commit real credentials.
APP_ENV=production
MODEL_SERVING_MODE=internal_gateway
APP_API_KEY=replace-with-a-random-api-key
INTERNAL_TOKEN=replace-with-a-random-internal-token

DATABASE_URL=postgresql+psycopg://rag_app:replace-with-db-password@postgres:5432/oa_rag
REDIS_URL=redis://:replace-with-redis-password@redis:6379/0

VECTOR_STORE_PROVIDER=milvus
MILVUS_URI=http://milvus:19530
SPARSE_INDEX_PROVIDER=opensearch
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_USERNAME=rag_app
OPENSEARCH_PASSWORD=replace-with-opensearch-password

# Campus intranet TEI, exposing the OpenAI-compatible /v1/embeddings endpoint.
EMBEDDING_PROVIDER=tei
EMBEDDING_API_BASE=http://tei-embedding.ai-platform.svc.cluster.local/v1
EMBEDDING_API_KEY=replace-with-tei-service-token
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_VECTOR_SIZE=1024
EMBEDDING_ALLOW_HASH_FALLBACK=false

# Student queries always use Hybrid retrieval, then the campus TEI reranker.
RETRIEVAL_STRATEGY=hybrid
HYBRID_FUSION_ALPHA=0.7
RERANK_ENABLED=true
RERANK_PROVIDER=tei
RERANK_API_BASE=http://tei-reranker.ai-platform.svc.cluster.local/rerank
RERANK_API_KEY=replace-with-reranker-service-token
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Image understanding stays inside the campus network.
IMAGE_RECOGNITION_PROVIDER=paddle_ocr
PADDLE_OCR_API_BASE=http://paddleocr.ai-platform.svc.cluster.local/v1/ocr
PADDLE_OCR_TOKEN=replace-with-paddleocr-service-token
MULTIMODAL_API_BASE=http://vllm-qwen3-vl.ai-platform.svc.cluster.local:8000/v1
MULTIMODAL_API_KEY=replace-with-vllm-vl-service-token
MULTIMODAL_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
IMAGE_VLM_CONFIDENCE_THRESHOLD=0.85
IMAGE_CACHE_ENABLED=true

# Campus intranet vLLM, exposing the OpenAI-compatible /v1/chat/completions endpoint.
LLM_PROVIDER=vllm
LLM_API_BASE=http://vllm-qwen3.ai-platform.svc.cluster.local:8000/v1
LLM_API_KEY=replace-with-vllm-service-token
LLM_MODEL=Qwen/Qwen3-14B
ALLOW_PROVIDER_FALLBACKS=false
HEALTH_PROBE_EXTERNAL_SERVICES=true
METRICS_AUTH_ENABLED=true
FAILED_UPLOAD_RETENTION_HOURS=72
FAILED_UPLOAD_CLEANUP_BATCH_SIZE=200

# Answer quality guardrails.
ANSWER_JUDGE_ENABLED=true
ANSWER_JUDGE_MODEL=replace-with-judge-model
ANSWER_JUDGE_MAX_TOKENS=320
ANSWER_JUDGE_MIN_FAITHFULNESS=0.80
ANSWER_JUDGE_MIN_RELEVANCE=0.75

PERMISSION_MODE=plugin
PERMISSION_PLUGIN=your_company.permissions.EnterprisePermissionChecker
RETRIEVAL_AUTHENTICATED_IDENTITY_REQUIRED=true
AUTH_SESSION_ENABLED=true
AUTH_SESSION_SECRET=replace-with-session-signing-secret

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_FAIL_OPEN=false
RATE_LIMIT_TRUST_X_FORWARDED_FOR=false

EVALUATION_EXECUTION_MODE=celery
CELERY_BROKER_URL=redis://:replace-with-redis-password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:replace-with-redis-password@redis:6379/2
