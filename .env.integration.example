# Copy this file to .env.integration. Do not commit real keys.
# docker compose --env-file .env.integration -f docker-compose.integration.yml up -d --build

APP_ENV=local
APP_API_KEY=replace-with-a-random-api-key
INTERNAL_TOKEN=replace-with-a-random-internal-token

POSTGRES_DB=oa_rag
POSTGRES_USER=rag_app
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_PORT=5432
REDIS_PORT=6379

MILVUS_COLLECTION=oa_rag_chunks_v2

# Use actual OpenAI-compatible services. Keep EMBEDDING_VECTOR_SIZE consistent
# with the selected embedding model; a collection must be recreated when it changes.
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_VECTOR_SIZE=1024

LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
