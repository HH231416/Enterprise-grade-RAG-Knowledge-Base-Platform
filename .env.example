APP_NAME=knowledge-base-system
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=18080
APP_API_PREFIX=/api/v1
SCENARIO_PROFILE=campus
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=50
APP_API_KEY=change-me
INTERNAL_TOKEN=change-me
PROVIDER_TIMEOUT_SECONDS=30
PROVIDER_RETRY_COUNT=1
HEALTH_PROBE_EXTERNAL_SERVICES=false
ALLOW_PROVIDER_FALLBACKS=true
# local: development process; internal_gateway: campus vLLM + TEI; external_api: cloud API.
MODEL_SERVING_MODE=local
LLM_PROVIDER=auto
EMBEDDING_PROVIDER=auto
RETRIEVAL_STRATEGY=hybrid
HYBRID_FUSION_ALPHA=0.7
RERANK_ENABLED=true
RERANK_PROVIDER=tei
RERANK_API_BASE=http://127.0.0.1:8081/rerank
RERANK_API_KEY=change-me
RERANK_MODEL=BAAI/bge-reranker-v2-m3
INGESTION_MODE=sync
FAILED_UPLOAD_RETENTION_HOURS=72
FAILED_UPLOAD_CLEANUP_BATCH_SIZE=200
# Evaluation: sync (local), background (in-process), celery (Redis worker)
EVALUATION_EXECUTION_MODE=sync
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ENABLE_FOLDER_SOURCE=false
FOLDER_SOURCE_ALLOWED_ROOTS=
ADMIN_MANUAL_USER_CREATION_ENABLED=false
ADMIN_AUTH_ENABLED=false
ADMIN_AUTH_USER_HEADERS=X-Authenticated-User,X-User-Id
ADMIN_AUTH_ALLOWED_ROLES=platform_admin
RETRIEVAL_AUTHENTICATED_IDENTITY_REQUIRED=false
AUTH_SESSION_ENABLED=false
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_SECONDS=3600
TRUSTED_IDENTITY_HEADER_ENABLED=false
TRUSTED_IDENTITY_USER_HEADERS=X-Authenticated-User,X-User-Id
TRUSTED_IDENTITY_EXTERNAL_SOURCE_HEADERS=X-Identity-Source,X-Auth-Issuer
TRUSTED_IDENTITY_EXTERNAL_ID_HEADERS=X-Identity-External-Id,X-Auth-Subject

# 权限配置
# none=无权限检查（默认），plugin=使用插件
PERMISSION_MODE=none
# 插件类路径（当 PERMISSION_MODE=plugin 时使用）
PERMISSION_PLUGIN=app.permissions.noop.NoOpPermissionChecker
# 校园管理员角色，多个角色用逗号分隔
CAMPUS_ADMIN_ROLES=campus_admin,school_admin

DATABASE_URL=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=oa_rag_poc
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# PostgreSQL connection pool (ignored by SQLite development mode)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Sparse retrieval: memory for local development, opensearch for multi-instance production
SPARSE_INDEX_PROVIDER=memory
OPENSEARCH_URL=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX=oa_rag_sparse_chunks

STORAGE_ROOT=
RAW_DATA_DIR=
PROCESSED_DATA_DIR=
SAMPLE_DATA_DIR=

ZILLIZ_URI=
ZILLIZ_TOKEN=
ZILLIZ_COLLECTION=oa_rag_chunks
VECTOR_STORE_PROVIDER=local

# 本地 Milvus（无认证时 MILVUS_TOKEN 留空）
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=oa_rag_chunks

EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_VECTOR_SIZE=2560

LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_TOKENS=1200
LLM_TEMPERATURE=0.1
# Agentic RAG: auto uses structured LLM rewrite when configured, otherwise heuristic fallback
AGENT_QUERY_REWRITE_MODE=auto
AGENT_QUERY_REWRITE_MAX_TOKENS=96
# Calibrated independently per retrieval score distribution
EVIDENCE_THRESHOLD_DENSE=0.35
EVIDENCE_THRESHOLD_HYBRID=0.55

DIFY_BASE_URL=http://127.0.0.1:8000
DIFY_APP_KEY=
DIFY_RETRIEVAL_USER_ID=dify-external

# IM 机器人通用配置
BOT_RESPONSE_MODE=qa
BOT_TOP_K=8
BOT_DEDUP_TTL_SECONDS=300

# 飞书自建应用机器人
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_BASE_URL=https://open.feishu.cn

# 企业微信自建应用机器人
WECOM_ENABLED=false
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_CALLBACK_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_BASE_URL=https://qyapi.weixin.qq.com

# 图片识别配置
# 提供者类型：paddle_ocr 或 multimodal
IMAGE_RECOGNITION_PROVIDER=paddle_ocr
PADDLE_OCR_API_BASE=http://127.0.0.1:8080/v1/ocr
# PaddleOCR API Token
PADDLE_OCR_TOKEN=
# 多模态大模型配置
MULTIMODAL_API_BASE=
MULTIMODAL_API_KEY=
MULTIMODAL_MODEL=
# 图片识别超时时间（秒）
IMAGE_RECOGNITION_TIMEOUT=30
# 批量处理大小
IMAGE_RECOGNITION_BATCH_SIZE=5
IMAGE_VLM_CONFIDENCE_THRESHOLD=0.85
IMAGE_CACHE_ENABLED=true
